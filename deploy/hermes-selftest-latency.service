; Hermes latency canary — the optional §3c self-test of
; plans/2026-11-25-context-length-learning-and-compression-loop.md.
;
; Tracked in git and installed from here, not hand-written on the box:
;   install -m 644 deploy/hermes-selftest-latency.service /etc/systemd/system/
;   install -m 644 deploy/hermes-selftest-latency.timer   /etc/systemd/system/
;   systemctl daemon-reload && systemctl enable --now hermes-selftest-latency.timer
;
; Sends one trivial prompt to the main provider and each fallback_providers
; entry and measures time-to-first-token. SLO breaches / failures become
; Needs-You cards (deduped per provider route). Exits immediately unless
; selftest.latency.enabled is true, and never writes config.yaml.

[Unit]
Description=Hermes latency self-test (TTFT per provider)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/opt/data/hermes-agent
Environment=HERMES_HOME=/opt/data/hermes-home-staging
ExecStart=/opt/data/hermes-agent/.venv/bin/hermes selftest latency
TimeoutStartSec=15min

Nice=10
IOSchedulingClass=idle
CPUWeight=30

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/data/hermes-home-staging /opt/data/hermes-agent
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
