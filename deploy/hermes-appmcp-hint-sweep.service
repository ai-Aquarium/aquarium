; app-mcp hint-gap sweep — Layer 3 (drift sweeper) of
; plans/2026-11-25-app-mcp-semantic-layer.md.
;
; Tracked in git and installed from here, not hand-written on the box:
;   install -m 644 deploy/hermes-appmcp-hint-sweep.service /etc/systemd/system/
;   install -m 644 deploy/hermes-appmcp-hint-sweep.timer   /etc/systemd/system/
;   systemctl daemon-reload && systemctl enable --now hermes-appmcp-hint-sweep.timer
;
; Reads the coverage ledger app-mcp writes on every snapshot
; ($HERMES_HOME/app-mcp/coverage-ledger.jsonl) and raises one owner Needs-You
; card listing controls the agent saw without a data-appmcp-hint and pages
; without a help.py guide. Deterministic and read-only on the code: drafting
; the hint lines is a human/agent PR from that card. The card dedupes on the gap
; set, so an unchanged night collapses onto the pending card.
;
; HERMES_HOME must equal HERMES_HOME in app-mcp.env (the gateway's home), or
; the sweep reads a ledger app-mcp never writes.

[Unit]
Description=app-mcp hint-gap sweep (Needs-You card for unhinted controls)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/opt/data/hermes-agent/app-mcp
Environment=HERMES_HOME=/opt/data/hermes-home-staging
ExecStart=/opt/data/hermes-agent/.venv/bin/python -m app_mcp.sweep --deliver

Nice=10
IOSchedulingClass=idle
CPUWeight=30

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/data/hermes-home-staging /opt/data/hermes-agent
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
