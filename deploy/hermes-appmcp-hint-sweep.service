; app-mcp hint-gap sweep — Layer 3 (drift sweeper) of
; plans/2026-11-25-app-mcp-semantic-layer.md.
;
; Installed as is (with its .timer, enabled) by install-aquarium.sh and by
; `aquarium update` / Settings -> Software upgrade on any box that runs app-mcp;
; a failed upgrade removes it again. Nothing here is box-specific: HERMES_HOME
; comes from app-mcp's own env files and the ledger from StateDirectory.
;
; Reads the coverage ledger app-mcp writes on every snapshot
; (/var/lib/app-mcp/coverage-ledger.jsonl) and raises one owner Needs-You
; card listing controls the agent saw without a data-appmcp-hint and pages
; without a help.py guide. Deterministic and read-only on the code: drafting
; the hint lines is a human/agent PR from that card. The card dedupes on the gap
; set, so an unchanged night collapses onto the pending card.

[Unit]
Description=app-mcp hint-gap sweep (Needs-You card for unhinted controls)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/opt/data/hermes-agent/app-mcp
# The gateway's env (DATABASE_URL, which config.yaml's app datastore DSN names:
# where the card goes), then app-mcp's (HERMES_HOME, the same home app-mcp uses).
EnvironmentFile=-/opt/data/hermes.env
EnvironmentFile=-/etc/aquarium/hermes.env
EnvironmentFile=-/opt/data/hermes-agent/app-mcp/app-mcp.env
EnvironmentFile=-/etc/aquarium/app-mcp.env
# The ledger app-mcp writes (deploy/app-mcp-ledger.conf); $STATE_DIRECTORY.
StateDirectory=app-mcp
StateDirectoryMode=0700
ExecStart=/opt/data/hermes-agent/.venv/bin/python -m app_mcp.sweep --deliver

Nice=10
IOSchedulingClass=idle
CPUWeight=30

NoNewPrivileges=yes
PrivateTmp=yes
# full, not strict: /usr, /boot and /etc stay read-only while HERMES_HOME
# (box-specific, so not nameable here) stays as writable as the hermes user's
# own permissions make it.
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
