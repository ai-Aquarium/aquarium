; Hermes compression advisories — the §4 advisory channel of
; plans/2026-11-25-context-length-learning-and-compression-loop.md.
;
; Tracked in git and installed from here, not hand-written on the box:
;   install -m 644 deploy/hermes-compression-advise.service /etc/systemd/system/
;   install -m 644 deploy/hermes-compression-advise.timer   /etc/systemd/system/
;   systemctl daemon-reload && systemctl enable --now hermes-compression-advise.timer
;
; Reads the per-turn compression ledger and the context-length learning log
; under HERMES_HOME and raises evidence-backed suggestions (a concrete
; compression.threshold, or pinning model.context_length) as Needs-You cards.
; It never writes config.yaml: applying a suggestion is always an owner action.
; Cards dedupe on (advisory kind, model@base_url / session), so a daily run
; collapses onto the pending card instead of stacking.

[Unit]
Description=Hermes compression advisories (Needs-You config suggestions)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/opt/data/hermes-agent
Environment=HERMES_HOME=/opt/data/hermes-home-staging
ExecStart=/opt/data/hermes-agent/.venv/bin/hermes compression advise

Nice=10
IOSchedulingClass=idle
CPUWeight=30

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/data/hermes-home-staging /opt/data/hermes-agent
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
